{
  "name": "hearth",
  "version": "0.1.0",
  "description": "Hearth: 事件驱动的极简模块化框架核心（TypeScript + Node.js）",
  "keywords": [
    "event-driven",
    "modular",
    "framework",
    "yaml",
    "typescript"
  ],
  "homepage": "https://github.com/Quan-Chan/Hearth#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Quan-Chan/Hearth.git"
  },
  "bugs": {
    "url": "https://github.com/Quan-Chan/Hearth/issues"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/hearth.js": "./dist/hearth.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "hearth": "dist/hearth.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/hearth.js",
    "test:compile": "tsc -p tsconfig.test.json",
    "test": "tsc -p tsconfig.test.json && node --test-isolation=none --test \".test-build/tests/**/*.test.js\"",
    "test:unit": "tsc -p tsconfig.test.json && node --test-isolation=none --test \".test-build/tests/unit/**/*.test.js\"",
    "test:integration": "tsc -p tsconfig.test.json && node --test-isolation=none --test \".test-build/tests/integration/**/*.test.js\"",
    "test:apps": "tsc -p tsconfig.test.json && node --test-isolation=none --test \".test-build/tests/apps/**/*.test.js\"",
    "docs:check": "node scripts/verify-docs.mjs && node scripts/check-doc-duplicates.mjs",
    "bench": "npm run build && node benchmarks/perf.js"
  },
  "dependencies": {
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0"
}